# ── Brevo (Sendinblue) Transactional Email Notification Config ──────────
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"

# Recipient email address(es) for instant lead alerts (comma-separated for multiple)
BREVO_TO_EMAIL="recruiter@linerecruiting.com, hiring@linerecruiting.com"

# Verified sender email in your Brevo account
BREVO_SENDER_EMAIL="leads@linerecruiting.com"

# Sender display name in email clients
BREVO_SENDER_NAME="BlueLine Recruiting Lead Alerts"

